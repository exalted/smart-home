#!/bin/sh
# Usage: shelly-name-check [--no-voice] [NAME...]
#
# Checks names (arguments, or one per line on stdin) against the house naming
# rules. By default, the rules for names a voice assistant may get (devices,
# groups, the scenes and rooms people use), which keep a name usable in
# HomeKit/Apple Home, Matter, Home Assistant, Siri/Alexa, shells and filenames:
#   - only ASCII letters, digits and single spaces
#   - starts and ends with a letter or digit
#   - at most 32 bytes (Matter's NodeLabel limit)
# With --no-voice, the looser rules for names that never reach a voice
# assistant (helpers, the Helpers room, hidden virtual components):
#   - ASCII letters, digits, single spaces and - _ . , : ( ) [ ] + %
#   - no leading or trailing space
#   - at most 50 bytes (the strictest Shelly app limit seen, on script names)
#   - a helper reads "[helper] <Stanza>: <azione>", so the Helpers room sorts
#     by the room or device it serves
# Both: unique within the checked set, ignoring case.
# Prints one JSON line per name: {name, bytes, ok, problems}. Exits 1 if any
# name fails. Which rules a name needs, and patterns such as
# "<Tipo> [porta] <stanza>" or "[helper] ...", are in the shelly-naming skill.
#
# Example: shelly-scan | jq -r .name | shelly-name-check
#          shelly-name-check --no-voice "[helper] Matrimoniale: apri"

set -eu
. "$(dirname "$0")/../lib/shelly.sh"
voice=true
case ${1:-} in
  -h | --help) usage_from_header; exit 0 ;;
  --no-voice) voice=false; shift ;;
esac
need jq

out=$(
  if [ $# -gt 0 ]; then printf '%s\n' "$@"; else cat; fi |
    jq -Rnc --argjson voice "$voice" '
      (if $voice
       then {chars: "^[A-Za-z0-9 ]+$", what: "letters, digits and spaces",
             ends: "^[^A-Za-z0-9]|[^A-Za-z0-9]$", ends_what: "must start and end with a letter or digit", max: 32}
       else {chars: "^[-A-Za-z0-9 _.,:()\\[\\]+%]+$", what: "letters, digits, spaces and - _ . , : ( ) [ ] + %",
             ends: "^ | $", ends_what: "must not start or end with a space", max: 50}
       end) as $rule
      | [inputs | select(length > 0)] as $names
      | ($names | map(ascii_downcase) | group_by(.) | map(select(length > 1) | .[0])) as $dups
      | $names[]
      | . as $n
      | ($n | ascii_downcase) as $lower
      | [ (if test($rule.chars) then empty else "only ASCII \($rule.what) are allowed" end),
          (if test($rule.ends) then $rule.ends_what else empty end),
          (if test("  ") then "contains consecutive spaces" else empty end),
          (if test("^\\[helper\\]") and (test("^\\[helper\\] [^ :][^:]*: [^ :][^:]*$") | not)
           then "a helper must read \"[helper] <Stanza>: <azione>\"" else empty end),
          (if utf8bytelength > $rule.max then "\(utf8bytelength) bytes, the limit is \($rule.max)" else empty end),
          (if any($dups[]; . == $lower) then "duplicate (ignoring case)" else empty end)
        ] as $problems
      | {name: $n, bytes: utf8bytelength, ok: ($problems | length == 0), problems: $problems}'
)
[ -n "$out" ] || exit 0
printf '%s\n' "$out"
printf '%s\n' "$out" | jq -se 'all(.ok)' >/dev/null
